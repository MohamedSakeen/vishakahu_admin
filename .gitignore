# ==============================================================================
# Vishakahu Admin Portal - Git Ignore Configuration
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js & Build Output
/.next/
/out/
/build
/dist
.turbo

# Environment Secrets (Strict catch-all: ignores all .env files except .env.example)
.env
.env.*
!.env.example

# Testing & Coverage
/coverage
*.lcov
.nyc_output

# TypeScript Build Info
tsconfig.tsbuildinfo
*.tsbuildinfo

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Temporary, Cache & Diagnostic Dump Files
*.tmp
*.temp
*temp*
*scratch*
*.sw?
*~
file_structure.txt
*report*.md
SECURITY_AUDIT_REPORT.md

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-workspace
*.sublime-project

# Security Credentials & Keys
*.pem
*.key
*.cert
*.crt
